# ========================================================
# brooo.ai — Master Environment Configuration (.env.example)
# ========================================================

# --- API Server Settings ---
PORT=4000
NODE_ENV=development
API_BASE_URL=http://localhost:4000

# --- Supabase (Local-First or Cloud) ---
# Default local Supabase values (provided by `supabase start`)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Unified AI Provider Configuration ---
# Options: 'openai' | 'gemini'
AI_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=sk-proj-your-openai-api-key
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_COMPLEX_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Google Gemini Configuration (Zero-downtime hot-swap ready)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL_FAST=gemini-2.0-flash
GEMINI_MODEL_COMPLEX=gemini-2.0-pro
GEMINI_EMBEDDING_MODEL=text-embedding-004

# --- Mobile App Client (EXPO_PUBLIC_*) ---
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/api/v1 # 10.0.2.2 for Android emulator, localhost for iOS simulator

